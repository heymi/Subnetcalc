{
  "aggregate": [
    {
      "input": [
        "192.168.0.0/24",
        "192.168.1.0/24"
      ],
      "expect": [
        "192.168.0.0/23"
      ]
    },
    {
      "input": [
        "10.0.0.0/24",
        "10.0.1.0/24",
        "10.0.2.0/24",
        "10.0.3.0/24"
      ],
      "expect": [
        "10.0.0.0/22"
      ]
    },
    {
      "input": [
        "10.0.0.0/24",
        "10.0.2.0/24"
      ],
      "expect": [
        "10.0.0.0/24",
        "10.0.2.0/24"
      ]
    },
    {
      "input": [
        "10.0.1.0/24",
        "10.0.2.0/24"
      ],
      "expect": [
        "10.0.1.0/24",
        "10.0.2.0/24"
      ]
    },
    {
      "input": [
        "10.0.0.0/8",
        "10.1.0.0/16"
      ],
      "expect": [
        "10.0.0.0/8"
      ]
    },
    {
      "input": [
        "192.168.1.37/26",
        "192.168.1.64/26",
        "192.168.1.128/25"
      ],
      "expect": [
        "192.168.1.0/24"
      ]
    },
    {
      "input": [
        "2001:db8::/48",
        "2001:db8:1::/48"
      ],
      "expect": [
        "2001:db8::/47"
      ]
    },
    {
      "input": [
        "2001:db8::/48",
        "2001:db8:1::/48",
        "2001:db8:2::/48"
      ],
      "expect": [
        "2001:db8::/47",
        "2001:db8:2::/48"
      ]
    }
  ],
  "supernet": [
    {
      "input": [
        "192.168.0.0/24",
        "192.168.3.0/24"
      ],
      "expect": "192.168.0.0/22"
    },
    {
      "input": [
        "10.0.1.0/24",
        "10.0.2.0/24"
      ],
      "expect": "10.0.0.0/22"
    },
    {
      "input": [
        "172.16.0.0/16",
        "172.31.0.0/16"
      ],
      "expect": "172.16.0.0/12"
    },
    {
      "input": [
        "10.0.0.0/8",
        "192.168.0.0/16"
      ],
      "expect": "0.0.0.0/0"
    },
    {
      "input": [
        "2001:db8:1::/48",
        "2001:db8:2::/48"
      ],
      "expect": "2001:db8::/46"
    },
    {
      "input": [
        "10.1.1.0/24"
      ],
      "expect": "10.1.1.0/24"
    },
    {
      "input": [
        "192.168.1.0/24",
        "192.168.1.128/25"
      ],
      "expect": "192.168.1.0/24"
    }
  ],
  "findOverlaps": [
    {
      "input": [
        "10.0.0.0/16",
        "10.0.5.0/24",
        "10.1.0.0/16",
        "10.0.0.0/16"
      ],
      "expect": [
        {
          "i": 0,
          "j": 1,
          "relation": "contains"
        },
        {
          "i": 0,
          "j": 3,
          "relation": "equal"
        },
        {
          "i": 1,
          "j": 3,
          "relation": "contained"
        }
      ]
    },
    {
      "input": [
        "192.168.0.0/24",
        "192.168.1.0/24"
      ],
      "expect": []
    },
    {
      "input": [
        "192.168.1.0/25",
        "192.168.1.0/24"
      ],
      "expect": [
        {
          "i": 0,
          "j": 1,
          "relation": "contained"
        }
      ]
    },
    {
      "input": [
        "2001:db8::/32",
        "2001:db8:ffff::/48",
        "2001:db9::/32"
      ],
      "expect": [
        {
          "i": 0,
          "j": 1,
          "relation": "contains"
        }
      ]
    }
  ],
  "rangeToCidrs": [
    {
      "start": "10.0.0.0",
      "end": "10.0.3.255",
      "expect": [
        "10.0.0.0/22"
      ]
    },
    {
      "start": "192.168.1.10",
      "end": "192.168.1.20",
      "expect": [
        "192.168.1.10/31",
        "192.168.1.12/30",
        "192.168.1.16/30",
        "192.168.1.20/32"
      ]
    },
    {
      "start": "0.0.0.0",
      "end": "255.255.255.255",
      "expect": [
        "0.0.0.0/0"
      ]
    },
    {
      "start": "10.0.0.5",
      "end": "10.0.0.5",
      "expect": [
        "10.0.0.5/32"
      ]
    },
    {
      "start": "2001:db8::",
      "end": "2001:db8::ff",
      "expect": [
        "2001:db8::/120"
      ]
    },
    {
      "start": "2001:db8::1",
      "end": "2001:db8::6",
      "expect": [
        "2001:db8::1/128",
        "2001:db8::2/127",
        "2001:db8::4/127",
        "2001:db8::6/128"
      ]
    }
  ],
  "split": [
    {
      "input": "192.168.1.0/24",
      "newPrefix": 26,
      "expect": [
        "192.168.1.0/26",
        "192.168.1.64/26",
        "192.168.1.128/26",
        "192.168.1.192/26"
      ]
    },
    {
      "input": "10.0.0.0/30",
      "newPrefix": 32,
      "expect": [
        "10.0.0.0/32",
        "10.0.0.1/32",
        "10.0.0.2/32",
        "10.0.0.3/32"
      ]
    },
    {
      "input": "2001:db8::/48",
      "newPrefix": 50,
      "expect": [
        "2001:db8::/50",
        "2001:db8:0:4000::/50",
        "2001:db8:0:8000::/50",
        "2001:db8:0:c000::/50"
      ]
    },
    {
      "input": "172.16.0.0/12",
      "newPrefix": 12,
      "expect": [
        "172.16.0.0/12"
      ]
    }
  ],
  "cidrsubnetArgs": [
    {
      "parent": "172.16.0.0/12",
      "child": "172.18.0.0/16",
      "note": "Terraform docs cidrsubnet example",
      "expect": {
        "newbits": 4,
        "netnum": 2
      }
    },
    {
      "parent": "10.1.2.0/24",
      "child": "10.1.2.240/28",
      "note": "Terraform docs cidrsubnet example",
      "expect": {
        "newbits": 4,
        "netnum": 15
      }
    },
    {
      "parent": "fd00:fd12:3456:7890::/56",
      "child": "fd00:fd12:3456:7800:a200::/72",
      "note": "Terraform docs cidrsubnet example",
      "expect": {
        "newbits": 16,
        "netnum": 162
      }
    },
    {
      "parent": "192.168.1.0/24",
      "child": "192.168.1.208/30",
      "note": "VLSM example P2P subnet",
      "expect": {
        "newbits": 6,
        "netnum": 52
      }
    }
  ],
